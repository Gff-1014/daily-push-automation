# DeepSeek（必填，部署/正式运行）
DEEPSEEK_API_KEY=sk-your-deepseek-key
# 聚合数据 全网热搜榜（必填，部署/正式运行）
JUHE_API_KEY=your-juhe-key
# 阶段4：自动邮件 HTTP 触发器地址（可先留空）
EMAIL_WEBHOOK_URL=
# 直接 SMTP 发信（推荐，替代已下架的 API 网关触发器）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=you@qq.com
SMTP_AUTH_CODE=your_auth_code
MAIL_TO=you@qq.com
# 腾讯云 COS / 部署（桶名格式：自定义名-APPID；部署脚本读取）
COS_BUCKET=your-bucket-1250000000
COS_REGION=ap-guangzhou
CET4_MEDIA_BUCKET=your-media-bucket-1250000000
MEDIA_PROXY_BASE_URL=https://your-proxy-function-url
# 可选：六级推送专用收件邮箱（留空则用 MAIL_TO）
VOCAB_MAIL_TO=
# 腾讯云 API 密钥（部署脚本读取；不要提交真实值）
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# 本地调试：1 表示用模拟 LLM（无需密钥）
LLM_MOCK=0
